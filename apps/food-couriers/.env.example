# Generated by SymplrV3. Copy to .env and fill in.
# Expo auto-loads EXPO_PUBLIC_* vars; restart `expo start` after changes.

# EXPO_PUBLIC_* IS PUBLIC. babel inlines these at build time, so every
# value below ships inside the JS bundle and can be read out of the
# downloaded app. Base URLs and other public config belong here.
# A SERVICE CREDENTIAL DOES NOT — terminate it at a backend and let the
# app carry only a user-scoped session token. See the credentials section
# at the bottom of this file if one is listed there.

# This app uses classic React Navigation (not expo-router) — required on SDK 56+:
EXPO_ROUTER_DISABLE_RN_NAVIGATION_CHECK=1

# Supabase Auth
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Data
# (also uses EXPO_PUBLIC_SUPABASE_URL, EXPO_PUBLIC_SUPABASE_ANON_KEY, declared above)
EXPO_PUBLIC_SUPABASE_DB_SCHEMA=
EXPO_PUBLIC_SUPABASE_PREFER=resolution=merge-duplicates
